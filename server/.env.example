PORT=5000
# Preferred database connection for Supabase/PostgreSQL.
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=village_products
DB_PORT=3306
# JWT configuration
NODE_ENV=development
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Secret shared only between this API and n8n. Generate a long random value.
N8N_API_KEY=replace_with_a_long_random_secret
# n8n production webhook called by the Admin analytics page through this API.
N8N_SALES_ANALYSIS_WEBHOOK_URL=https://your-n8n.example/webhook/huypaso-sales-analysis
# Optional Header Auth value sent as x-webhook-key. Keep blank only if the webhook has no auth.
N8N_WEBHOOK_KEY=replace_with_a_different_long_random_secret
N8N_WEBHOOK_TIMEOUT_MS=45000
# Used to anonymize user IDs before behavior data leaves this API.
ANALYTICS_HASH_SALT=replace_with_a_different_random_secret
ANALYTICS_RUN_STALE_MINUTES=30

# Cancel pending orders without a payment slip and return their reserved stock.
PAYMENT_PENDING_EXPIRATION_MINUTES=10
PAYMENT_EXPIRATION_CHECK_INTERVAL_MS=30000

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
CLIENT_APP_URL=http://localhost:5173

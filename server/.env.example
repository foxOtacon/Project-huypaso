PORT=5000

# Supabase project configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Supabase PostgreSQL connection
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# JWT configuration
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
CLIENT_APP_URL=http://localhost:5173

# Secret shared only between this API and n8n. Generate a long random value.
N8N_API_KEY=replace-with-a-long-random-secret
# Used to anonymize user IDs before behavior data leaves this API.
ANALYTICS_HASH_SALT=replace-with-a-different-random-secret
N8N_SALES_ANALYSIS_WEBHOOK_URL=https://your-n8n.example/webhook/huypaso-sales-analysis
N8N_WEBHOOK_KEY=replace-with-a-different-long-random-secret
N8N_WEBHOOK_TIMEOUT_MS=45000
ANALYTICS_RUN_STALE_MINUTES=30

# Product recommendations configuration
N8N_PRODUCT_RECOMMENDATIONS_WEBHOOK_URL=https://your-n8n.example/webhook/huypaso-product-recommendations
N8N_PRODUCT_RECOMMENDATIONS_WEBHOOK_KEY=replace-with-a-different-long-random-secret
N8N_PRODUCT_RECOMMENDATIONS_TIMEOUT_MS=45000
RECOMMENDATIONS_CACHE_TTL_MS=120000

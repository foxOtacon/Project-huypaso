{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/uploads/:path*", "destination": "/api/uploads/:path*" },
    { "source": "/((?!api/|assets/|uploads/).*)", "destination": "/index.html" }
  ]
}
